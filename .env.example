# Server
NODE_ENV=development
# Opt in only for a private local session (never behind a public reverse proxy).
# Requires NODE_ENV=development and a loopback request; tokens are never logged.
ALLOW_DEV_RESET_TOKEN=false

# JWT Authentication
JWT_SECRET=REPLACE_WITH_YOUR_OWN_SECURE_RANDOM_SECRET
JWT_EXPIRES_IN=1h

# Shopify Configuration
SHOPIFY_SHOP=your-development-store
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
