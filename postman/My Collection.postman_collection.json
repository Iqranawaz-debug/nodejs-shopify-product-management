    {
      "name": "Shopify - manual opt-in only",
      "description": "Every mutation requires a fresh one-request allow_shopify_mutations=true environment opt-in. All are skipped by default.",
      "item": [
        {
          "name": "Shopify list products",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('run_shopify_reads') !== 'true') pm.execution.skipRequest();"
                ]
