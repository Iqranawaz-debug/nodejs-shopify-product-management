{
  "info": {
    "name": "Node Development Test - Clean Review",
    "description": "Import this v2.1 collection and the accompanying Local Review environment. Select that environment and set base_url to a private local server. Run the Local assessment folder: signup generates fresh disposable credentials, login saves JWT, and CRUD captures its own ID. For the full reset sequence, launch the server locally with NODE_ENV=development and ALLOW_DEV_RESET_TOKEN=true; only loopback requests can receive tokens. Without that opt-in the reset and new-password requests are skipped, not passed. Production never returns reset tokens. No recovery email is implemented. Do not run this local test flow against production. All Shopify requests are disabled by default: set run_shopify_reads=true for reads. For EACH individual authorized Shopify write, set allow_shopify_mutations=true immediately before sending; the pre-request guard resets it to false. Run these writes individually, never as an unattended collection. Use only a disposable development product and its numeric ID. Never publish an environment after a run without clearing all credentials, JWTs, reset tokens and IDs. Flags in the Postman environment do not configure the server. Password reset invalidates all earlier JWTs. Login with the new password to continue protected requests. Authentication attempts are limited per IP per 15 minutes (signup 20, login 30, forgot 10, reset 20); 429 includes Retry-After.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
