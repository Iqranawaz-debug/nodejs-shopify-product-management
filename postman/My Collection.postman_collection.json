            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Success flag', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('Products array and count', () => { const b = pm.response.json(); pm.expect(b.products).to.be.an('array'); pm.expect(b.count).to.eql(b.products.length); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/shopify/products"
          },
          "response": []
        },
        {
          "name": "Shopify create product - explicit opt-in",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Explicit one-request opt-in. Default collection runs skip all Shopify writes.",
                  "if (pm.environment.get('allow_shopify_mutations') !== 'true') {",
                  "  pm.execution.skipRequest();",
                  "} else {",
                  "  pm.environment.set('allow_shopify_mutations', 'false');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
