        {
          "name": "Signup reviewer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate disposable local credentials for each collection run. Use a separate manual request for an existing account.",
                  "const runId = pm.variables.replaceIn('{{$guid}}');",
                  "pm.environment.set('email', 'reviewer-' + runId + '@example.com');",
                  "pm.environment.set('password', 'Review-' + pm.variables.replaceIn('{{$guid}}'));",
                  "pm.environment.set('new_password', 'Reset-' + pm.variables.replaceIn('{{$guid}}'));",
                  "['jwt_token', 'reset_token', 'product_id'].forEach(key => pm.environment.unset(key));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Success flag', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('Safe user response', () => { const u = pm.response.json().user; pm.expect(u.id).to.be.a('number'); pm.expect(u).not.to.have.property('password'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
